<!doctype html><html><head><title>Risk Events</title><style>body{font-family:Arial;margin:30px;background:#f6f8fb}.card{background:#fff;padding:18px;border-radius:10px}table{width:100%;border-collapse:collapse}th,td{border-bottom:1px solid #ddd;padding:8px;text-align:left}</style></head><body><h1>Risk Events</h1><p><a href="/">Back</a></p><div class="card"><table><tr><th>ID</th><th>Severity</th><th>Type</th><th>Message</th><th>Screenshot</th><th>Created</th></tr><% events.forEach(e=>{ %><tr><td><%= e.id %></td><td><%= e.severity %></td><td><%= e.event_type %></td><td><%= e.message %></td><td><% if(e.screenshot_path){ %><%= e.screenshot_path %><% } %></td><td><%= e.created_at %></td></tr><% }) %></table></div></body></html>