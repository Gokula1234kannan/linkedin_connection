<!doctype html><html><head><title>LinkedIn Connection Engine</title><style>body{font-family:Arial;margin:30px;background:#f6f8fb;color:#17212b}.card{background:white;padding:18px;border-radius:10px;margin-bottom:18px;box-shadow:0 1px 6px #d9e0ea}table{width:100%;border-collapse:collapse;background:white}th,td{border-bottom:1px solid #e5e7eb;padding:8px;text-align:left;font-size:13px}th{background:#eef2f7}.badge{padding:3px 7px;border-radius:7px;background:#e5e7eb}.nav a{margin-right:12px}button{padding:6px 10px}</style></head><body><h1>LinkedIn Connection Engine</h1><div class="nav"><a href="/">Dashboard</a><a href="/risk-events">Risk Events</a><a href="/export">Export Excel Report</a></div><div class="card"><h2>Upload Excel</h2><form action="/upload" method="post" enctype="multipart/form-data"><input name="name" placeholder="Campaign name"/> <input type="file" name="file" accept=".xlsx,.xls,.csv" required/> <button>Upload</button></form><p>Required: first_name, last_name, company. Optional: job_title, linkedin_url, email, location, notes.</p></div><div class="card"><h2>Status Summary</h2><% if(stats.length===0){ %><p>No leads yet.</p><% } %><% stats.forEach(s=>{ %><span class="badge"><%= s.status %>: <%= s.count %></span> <% }) %></div><div class="card"><h2>Campaigns</h2><table><tr><th>ID</th><th>Name</th><th>Status</th><th>Created</th><th>Action</th></tr><% campaigns.forEach(c=>{ %><tr><td><%= c.id %></td><td><%= c.name %></td><td><%= c.status %></td><td><%= c.created_at %></td><td><form method="post" action="/campaign/<%= c.status==='ACTIVE'?'pause':'resume' %>/<%= c.id %>"><button><%= c.status==='ACTIVE'?'Pause':'Resume' %></button></form></td></tr><% }) %></table></div><div class="card"><h2>Recent Leads</h2><table><tr><th>ID</th><th>Name</th><th>Company</th><th>Title</th><th>LinkedIn</th><th>Message</th><th>Status</th><th>Error</th><th>Action</th></tr><% leads.forEach(l=>{ %><tr><td><%= l.id %></td><td><%= l.first_name %> <%= l.last_name %></td><td><%= l.company %></td><td><%= l.job_title %></td><td><% if(l.linkedin_url){ %><a target="_blank" href="<%= l.linkedin_url %>">Open</a><% } %></td><td><%= l.message %></td><td><%= l.status %></td><td><%= l.error_reason %></td><td><form method="post" action="/campaign/requeue/<%= l.id %>"><button>Requeue</button></form></td></tr><% }) %></table></div></body></html>